# Project data and outputs (large, generated, or user-supplied)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# IDE
.idea/
.vscode/
*.swp
